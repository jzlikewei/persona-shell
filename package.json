{
  "name": "persona-shell",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun src/index.ts",
    "init": "sh scripts/init.sh",
    "build": "bun build src/index.ts --outdir dist --target node",
    "check": "tsc --noEmit && sh scripts/check-no-any.sh",
    "smoke:web": "bun scripts/smoke-web-console.ts",
    "test:api": "bun scripts/test-api-smoke.ts",
    "test:e2e": "bun scripts/test-e2e-flow.ts",
    "test:shell": "PERSONA_TEST=1 PERSONA_CONSOLE_PORT=3099 bun src/index.ts",
    "start": "bun dist/index.js",
    "install-service": "sh scripts/install-service.sh",
    "uninstall-service": "sh scripts/uninstall-service.sh"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.36.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
